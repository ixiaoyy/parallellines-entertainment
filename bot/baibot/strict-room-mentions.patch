+            AnySyncMessageLikeEvent, AnySyncTimelineEvent, SyncMessageLikeEvent,
+            room::message::{
+                MessageType, OriginalSyncRoomMessageEvent, Relation, RoomMessageEventContent,
+                sanitize::remove_plain_reply_fallback,
+            },
+        },
+    },
+    sync::RoomUpdates,
+};
+use mxlink::{CallbackError, MessageResponseType, ThreadInfo};
+
+use crate::agent::{
+    AgentProvider, ControllerTrait,
+    provider::{TextGenerationParams, TextGenerationPromptVariables, openai_compat},
+};
+use crate::conversation::llm::{Author, Conversation, Message, MessageContent};
+use crate::entity::cfg::Config;
+
+use super::{
+    Bot,
+    tavern_admission::{
+        Admission, Decision, Trigger, ambient_has_legacy_mention, ambient_sample, gateway_notice,
+        is_new, local_main_sender,
+    },
+    tavern_room::{eligible_invitation, joined_after},
+};
+
+const MAX_MESSAGE_BYTES: usize = 4096;
+const AMBIENT_LIVE_MAX_AGE_MS: i64 = 15_000;
+const REPLY_TIMEOUT: Duration = Duration::from_secs(20);
+const JOIN_TIMEOUT: Duration = Duration::from_secs(20);
+
+pub(super) struct TavernPilot {
+    first_message: Option<String>,
+    talkativeness: f64,
+    admission: std::sync::Mutex<Admission>,
+    generation: tokio::sync::Mutex<()>,
+}
+
+impl TavernPilot {
+    /// 从静态配置收紧试用范围，配置不完整时在 Matrix 登录前停止。
+    pub(super) fn new(config: &Config) -> anyhow::Result<Self> {
+        // 房间和用户由 Matrix 原生成员关系授权；房间内没有 Bot 管理命令。
+        anyhow::ensure!(
+            config.access.admin_patterns.is_empty(),
+            "Tavern pilot does not allow admin patterns"
+        );
+        anyhow::ensure!(
+            config.logging == "warn" && config.user.mxid_localpart.starts_with("bot_"),
+            "Tavern pilot requires warning-only logging and a dedicated bot_ Matrix account"
+        );
+        anyhow::ensure!(
+            config.user.password.as_deref().is_none_or(str::is_empty),
+            "Tavern pilot requires Matrix access token and device ID, not password login"
+        );
+
+        let [agent] = config.agents.static_definitions.as_slice() else {
+            anyhow::bail!("Tavern pilot requires exactly one static agent");
+        };
+        anyhow::ensure!(
+            agent.id == "role" && matches!(&agent.provider, AgentProvider::OpenAICompat),
+            "Tavern pilot requires the static/role openai-compatible agent"
+        );
+        let provider: openai_compat::Config = serde_yaml_ng::from_value(agent.config.clone())
+            .map_err(|_| anyhow::anyhow!("Invalid Tavern pilot agent configuration"))?;
+        anyhow::ensure!(
+            provider.base_url == openai_compat::TAVERN_FLUX_BASE_URL,
+            "Tavern Flux role requires the dedicated paid gateway URL"
+        );
+        anyhow::ensure!(
+            provider
+                .api_key
+                .as_deref()
+                .is_some_and(|key| !key.trim().is_empty()),
+            "Tavern Flux role requires its dedicated gateway service token"
+        );
+        let text = provider
+            .text_generation
+            .ok_or_else(|| anyhow::anyhow!("Tavern pilot requires text generation settings"))?;
+        anyhow::ensure!(
+            !text.model_id.trim().is_empty()
+                && text.model_id != "some-model"
+                && text
+                    .prompt
+                    .as_deref()
+                    .is_some_and(|prompt| !prompt.trim().is_empty())
+                && matches!(text.max_response_tokens, Some(1..=1024)),
+            "Tavern pilot needs a fixed model, character prompt and 1..=1024 response tokens"
+        );
+
+        let (first_message, talkativeness) = match &config.tavern_card {
+            Some(card) => {
+                anyhow::ensure!(
+                    config.user.mxid_localpart == "bot_flux-the-cat",
+                    "Tavern card participation is only supported for Flux"
+                );
+                anyhow::ensure!(
+                    card.first_message.as_deref().is_none_or(|message| {
+                        !message.trim().is_empty() && message.len() <= MAX_MESSAGE_BYTES
+                    }),
+                    "Invalid Tavern card first message"
+                );
+                let talkativeness = card.talkativeness.unwrap_or(0.0);
+                anyhow::ensure!(
+                    (0.0..=1.0).contains(&talkativeness),
+                    "Invalid Tavern card talkativeness"
+                );
+                (card.first_message.clone(), talkativeness)
+            }
+            None => (None, 0.0),
+        };
+        Ok(Self {
+            first_message,
+            talkativeness,
+            admission: std::sync::Mutex::default(),
+            generation: tokio::sync::Mutex::default(),
+        })
+    }
+
+    /// 复用 Matrix 原生邀请及加密消息接线，不挂载命令/反应入口。
+    pub(super) fn attach(bot: &Bot) {
+        let started_at_ms = Utc::now().timestamp_millis();
+        let updates = bot.matrix_link().client().subscribe_to_all_room_updates();
+        let pilot_bot = bot.clone();
+        tokio::spawn(async move {
+            pilot_bot
+                .tavern_pilot()
+                .process_room_updates(&pilot_bot, updates, started_at_ms)
+                .await;
+        });
+
+        let pilot_bot = bot.clone();
+        // 要求 SDK 确认本事件解密成功；不能只看房间标记，也不能接受明文伪造事件。
+        bot.matrix_link().client().add_event_handler(
+            move |event: OriginalSyncRoomMessageEvent,
+                  room: Room,
+                  crypto: Option<EncryptionInfo>| async move {
+                if crypto.is_none() || !is_explicit_mention(&pilot_bot, &event) {
+                    return;
+                }
+                dispatch_message(&pilot_bot, room, event, started_at_ms, Trigger::Mention);
+            },
+        );
+    }
+
+    /// 首次同步或订阅落后后的补同步只恢复未加入的邀请，不重播问候或对旧消息主动应答。
+    async fn process_room_updates(
+        &self,
+        bot: &Bot,
+        mut updates: tokio::sync::broadcast::Receiver<RoomUpdates>,
+        started_at_ms: i64,
+    ) {
+        let client = bot.matrix_link().client();
+        let mut live = false;
+        loop {
+            if !live {
+                for room in client.invited_rooms() {
+                    self.join_invitation(bot, room, false).await;
+                }
+            }
+            let changes = match updates.recv().await {
+                Ok(changes) => changes,
+                Err(tokio::sync::broadcast::error::RecvError::Lagged(_)) => {
+                    // 跳过落后接收器的全部旧批次；新订阅首包仍按补同步处理。
+                    updates = client.subscribe_to_all_room_updates();
+                    live = false;
+                    continue;
+                }
+                Err(tokio::sync::broadcast::error::RecvError::Closed) => return,
+            };
+            if live && self.talkativeness > 0.0 {
+                for (room_id, update) in changes.joined {
+                    // 同步批次不全时不能区分缺口中的历史和新消息，不参与。
+                    if update.timeline.limited {
+                        continue;
+                    }
+                    let Some(room) = client.get_room(&room_id) else {
+                        continue;
+                    };
+                    for item in update.timeline.events {
+                        if item.encryption_info().is_none() {
+                            continue;
+                        }
+                        if let Ok(AnySyncTimelineEvent::MessageLike(
+                            AnySyncMessageLikeEvent::RoomMessage(SyncMessageLikeEvent::Original(
+                                event,
+                            )),
+                        )) = item.raw().deserialize()
+                        {
+                            if !is_explicit_mention(bot, &event) {
+                                dispatch_message(
+                                    bot,
+                                    room.clone(),
+                                    event,
+                                    started_at_ms,
+                                    Trigger::Ambient,
+                                );
+                            }
+                        }
+                    }
+                }
+            }
+            if !changes.invited.is_empty() {
+                for room in client.invited_rooms() {
+                    let fresh_invite = live && changes.invited.contains_key(room.room_id());
+                    self.join_invitation(bot, room, fresh_invite).await;
+                }
+            }
+            live = true;
+        }
+    }
+
+    /// 只加入具有正面私密、加密证据的房间；问候只在新邀请成功加入且正式状态回显后发送。
+    async fn join_invitation(&self, bot: &Bot, room: Room, live: bool) {
+        match eligible_invitation(&room).await {
+            Ok(true) => {}
+            Ok(false) => return,
+            Err(_) => {
+                tracing::warn!("Could not verify Tavern invite state; not joining");
+                return;
+            }
+        }
+        let greeting = self.first_message.as_ref().filter(|_| live).map(|message| {
+            let mut updates = bot
+                .matrix_link()
+                .client()
+                .subscribe_to_room_updates(room.room_id());
+            let lower_bound = Utc::now().timestamp_millis();
+            // 订阅先于 join，避免 Matrix 回显早于 HTTP join 结果时丢掉问候。
+            let room = room.clone();
+            let user_id = bot.user_id().to_owned();
+            let message = message.clone();
+            async move {
+                loop {
+                    if let Ok(Some((joined_ms, event_id))) = joined_after(&room, &user_id).await {
+                        if joined_ms >= lower_bound {
+                            // 同一原生入房事件用固定事务 ID；无模型、无账本、无历史查询。
+                            let transaction =
+                                OwnedTransactionId::from(format!("flux_greeting_{event_id}"));
+                            return room
+                                .send(RoomMessageEventContent::text_plain(message))
+                                .with_transaction_id(transaction)
+                                .await
+                                .is_ok();
+                        }
+                    }
+                    if updates.recv().await.is_err() {
+                        return false;
+                    }
+                }
+            }
+        });
+        match tokio::time::timeout(JOIN_TIMEOUT, room.join()).await {
+            Ok(Ok(())) => {
+                if let Some(greeting) = greeting {
+                    tokio::spawn(async move {
+                        if !matches!(
+                            tokio::time::timeout(REPLY_TIMEOUT, greeting).await,
+                            Ok(true)
+                        ) {
+                            tracing::warn!("Tavern Flux greeting not confirmed");
+                        }
+                    });
+                }
+            }
+            Ok(Err(_)) => tracing::warn!("Tavern room join failed; native invite retained"),
+            Err(_) => tracing::warn!("Tavern room join result unknown"),
+        }
+    }
+
+    /// 只有新发的纯文本可送模型；主动接话额外验证人、提及与卡内概率，不回读历史。
+    async fn on_message(
+        &self,
+        bot: &Bot,
+        room: Room,
+        event: OriginalSyncRoomMessageEvent,
+        started_at_ms: i64,
+        trigger: Trigger,
+    ) -> Result<(), CallbackError> {
+        if &event.sender == bot.user_id()
+            || room.state() != RoomState::Joined
+            || !matches!(room.encryption_state(), EncryptionState::Encrypted)
+        {
+            return Ok(());
+        }
+
+        let MessageType::Text(text) = &event.content.msgtype else {
+            return Ok(());
+        };
+        if trigger == Trigger::Ambient
+            && (text.body.len() > MAX_MESSAGE_BYTES
+                || !local_main_sender(
+                    event.sender.localpart(),
+                    event.sender.server_name() == bot.user_id().server_name(),
+                )
+                || event.content.relates_to.is_some()
+                || event
+                    .content
+                    .mentions
+                    .as_ref()
+                    .is_some_and(|m| m.room || !m.user_ids.is_empty())
+                || ambient_has_legacy_mention(
+                    &text.body,
+                    text.formatted.as_ref().map(|f| f.body.as_str()),
+                )
+                || !ambient_sample(event.event_id.as_str(), self.talkativeness))
+        {
+            return Ok(());
+        }
+        // 回复和线程只使用本事件的新增正文，SDK 的旧客户端引用前缀不传给模型。
+        let (body, response_type) = match &event.content.relates_to {
+            None => (
+                text.body.as_str(),
+                MessageResponseType::Reply(event.event_id.clone()),
+            ),
+            Some(Relation::Reply(_)) => (
+                remove_plain_reply_fallback(&text.body),
+                MessageResponseType::Reply(event.event_id.clone()),
+            ),
+            Some(Relation::Thread(thread)) => (
+                remove_plain_reply_fallback(&text.body),
+                MessageResponseType::InThread(ThreadInfo::new(
+                    thread.event_id.clone(),
+                    event.event_id.clone(),
+                )),
+            ),
+            // 拒绝替换（编辑）及其他关联类型，避免再次触发或夹带正文。
+            _ => return Ok(()),
+        };
+        let body = body.trim();
+        if body.is_empty() || body.len() > MAX_MESSAGE_BYTES {
+            return Ok(());
+        }
+
+        let timestamp_ms: u64 = event.origin_server_ts.0.into();
+        let Ok(timestamp_ms) = i64::try_from(timestamp_ms) else {
+            return Ok(());
+        };
+        let now = Utc::now();
+        let now_ms = now.timestamp_millis();
+        if trigger == Trigger::Ambient
+            && now_ms.saturating_sub(timestamp_ms) > AMBIENT_LIVE_MAX_AGE_MS
+        {
+            return Ok(());
+        }
+        // 只使用当前已加入房间的正式状态；无资格或消息早于加入、启动都不响应。
+        let joined = joined_after(&room, bot.user_id()).await.map_err(|_| {
+            CallbackError::Unknown("Could not read verified Tavern room state".into())
+        })?;
+        if joined
+            .is_none_or(|(joined_ms, _)| !is_new(timestamp_ms, started_at_ms, joined_ms, now_ms))
+        {
+            return Ok(());
+        }
+
+        // 所有房间共享一个模型请求；每房 10 秒至少间隔，不排队，不重复发送提示。
+        let generation = self.generation.try_lock();
+        let decision = self
+            .admission
+            .lock()
+            .map_err(|_| CallbackError::Unknown("Tavern event admission is unavailable".into()))?
+            .decide(
+                room.room_id().as_str(),
+                event.event_id.as_str(),
+                timestamp_ms,
+                now_ms,
+                generation.is_ok(),
+                trigger,
+            );
+        let (generation, notice) = match decision {
+            Decision::Model => (generation.ok(), None),
+            _ if trigger == Trigger::Ambient => return Ok(()),
+            Decision::RoomLimited => (None, Some("本房间调用太快，稍后再试。")),
+            Decision::Busy => (None, Some("角色正在回复，稍后再试。")),
+            Decision::Ignore => return Ok(()),
+        };
+        let reply = if let Some(notice) = notice {
+            notice.to_owned()
+        } else {
+            let agent = bot.agent_manager().only_static_agent().ok_or_else(|| {
+                CallbackError::Unknown("Tavern pilot static agent is missing".into())
+            })?;
+            let controller = agent.controller();
+            let conversation = Conversation {
+                messages: vec![Message {
+                    author: Author::User,
+                    sender_id: None,
+                    timestamp: now,
+                    content: MessageContent::Text(body.to_owned()),
+                }],
+            };
+            let params = TextGenerationParams {
+                prompt_variables: TextGenerationPromptVariables::new(
+                    bot.name(),
+                    &controller.text_generation_model_id().unwrap_or_default(),
+                    now,
+                    Some(now),
+                ),
+                tavern_flux: Some(openai_compat::TavernFluxContext {
+                    room_id: room.room_id().to_owned(),
+                    event_id: event.event_id.clone(),
+                }),
+                ..TextGenerationParams::default()
+            };
+
+            let started = std::time::Instant::now();
+            match controller.generate_text(conversation, params).await {
+                Ok(result) if !result.text.trim().is_empty() && result.text.len() <= 16_384 => {
+                    result.text
+                }
+                Ok(_) => {
+                    tracing::warn!(elapsed = ?started.elapsed(), "Tavern model returned empty or oversized text");
+                    if trigger == Trigger::Ambient {
+                        return Ok(());
+                    }
+                    "角色暂时无法回复。".to_owned()
+                }
+                Err(err) => {
+                    let request_error = err.downcast_ref::<reqwest::Error>();
+                    let status = request_error.and_then(reqwest::Error::status);
+                    let timeout = request_error.is_some_and(reqwest::Error::is_timeout);
+                    tracing::warn!(elapsed = ?started.elapsed(), ?status, timeout, "Tavern model generation failed");
+                    if trigger == Trigger::Ambient {
+                        return Ok(());
+                    }
+                    gateway_notice(status.map(|code| code.as_u16())).to_owned()
+                }
+            }
+        };
+
+        // 用纯文本机器人通知回复，避免把模型输出当作 HTML、外部媒体或新的提及。
+        let mut content = RoomMessageEventContent::notice_plain(reply);
+        let messaging = bot.matrix_link().messaging();
+        let send = messaging.send_event(&room, &mut content, response_type);
+        match tokio::time::timeout(REPLY_TIMEOUT, send).await {
+            Ok(Ok(_)) => {}
+            Ok(Err(_)) => tracing::warn!("Tavern pilot failed to send the Matrix reply"),
+            Err(_) => tracing::warn!("Tavern pilot Matrix reply timed out"),
+        }
+        drop(generation);
+        Ok(())
+    }
+}
+
+fn is_explicit_mention(bot: &Bot, event: &OriginalSyncRoomMessageEvent) -> bool {
+    event
+        .content
+        .mentions
+        .as_ref()
+        .is_some_and(|mentions| mentions.user_ids.iter().any(|user| user == bot.user_id()))
+}
+
+fn dispatch_message(
+    bot: &Bot,
+    room: Room,
+    event: OriginalSyncRoomMessageEvent,
+    started_at_ms: i64,
+    trigger: Trigger,
+) {
+    let bot = bot.clone();
+    tokio::spawn(async move {
+        if let Err(err) = bot
+            .tavern_pilot()
+            .on_message(&bot, room, event, started_at_ms, trigger)
+            .await
+        {
+            tracing::warn!(?err, "Tavern actionable message failed");
+        }
+    });
+}
diff --git a/src/bot/tavern_admission.rs b/src/bot/tavern_admission.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2c02bd93971ea50629a8e96e10ec171f074111a4
--- /dev/null
+++ b/src/bot/tavern_admission.rs
@@ -0,0 +1,236 @@
+use std::collections::HashMap;
+
+const MAX_EVENT_AGE_MS: i64 = 120_000;
+const MAX_SEEN_EVENTS: usize = 1024;
+const ROOM_MODEL_COOLDOWN_MS: i64 = 10_000;
+const ROOM_AMBIENT_COOLDOWN_MS: i64 = 60_000;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(super) enum Trigger {
+    Mention,
+    Ambient,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(super) enum Decision {
+    Model,
+    RoomLimited,
+    Busy,
+    Ignore,
+}
+
+#[derive(Default)]
+pub(super) struct Admission {
+    seen: HashMap<String, i64>,
+    room_last_call: HashMap<String, i64>,
+    room_last_ambient: HashMap<String, i64>,
+}
+
+impl Admission {
+    /// 先记新事件再给答复或模型一次机会；房间频率独立，全局并发由调用者持有。
+    /// 只保留时间窗口内的 ID，不存正文、不限制可加入的房间数。
+    pub(super) fn decide(
+        &mut self,
+        room_id: &str,
+        event_id: &str,
+        timestamp_ms: i64,
+        now_ms: i64,
+        generation_available: bool,
+        trigger: Trigger,
+    ) -> Decision {
+        self.seen
+            .retain(|_, event_ms| *event_ms >= now_ms - MAX_EVENT_AGE_MS);
+        if self.seen.len() >= MAX_SEEN_EVENTS || self.seen.contains_key(event_id) {
+            return Decision::Ignore;
+        }
+        self.seen.insert(event_id.to_owned(), timestamp_ms);
+
+        self.room_last_call
+            .retain(|_, last_call_ms| now_ms - *last_call_ms < ROOM_MODEL_COOLDOWN_MS);
+        self.room_last_ambient
+            .retain(|_, last_call_ms| now_ms - *last_call_ms < ROOM_AMBIENT_COOLDOWN_MS);
+        if trigger == Trigger::Ambient && self.room_last_ambient.contains_key(room_id) {
+            return Decision::Ignore;
+        }
+        if self.room_last_call.contains_key(room_id) {
+            return Decision::RoomLimited;
+        }
+        if !generation_available {
+            return Decision::Busy;
+        }
+        self.room_last_call.insert(room_id.to_owned(), now_ms);
+        if trigger == Trigger::Ambient {
+            self.room_last_ambient.insert(room_id.to_owned(), now_ms);
+        }
+        Decision::Model
+    }
+}
+
+/// 主站账户使用本域 `pl_<数字 subject>`；不主动响应联邦账号、技术账号或旧本地用户名。
+pub(super) fn local_main_sender(localpart: &str, local_server: bool) -> bool {
+    local_server
+        && localpart.strip_prefix("pl_").is_some_and(|subject| {
+            !subject.is_empty() && subject.bytes().all(|byte| byte.is_ascii_digit())
+        })
+}
+
+/// 没有结构化 mentions 的旧客户端也不能让角色抢答纯文本提及或 Matrix 用户链接。
+pub(super) fn ambient_has_legacy_mention(body: &str, formatted: Option<&str>) -> bool {
+    let mention = |text: &str| {
+        let text = text.to_ascii_lowercase();
+        text.contains(['@', '＠'])
+            || text.contains("%40")
+            || text.contains("&#64;")
+            || text.contains("&#x40;")
+            || text.contains("matrix:u/")
+    };
+    mention(body) || formatted.is_some_and(|html| html.len() > 16_384 || mention(html))
+}
+
+/// 对同一 Matrix 事件固定抽样：网关重放检测仍使用原事件 ID，不为主动接话造新 ID。
+pub(super) fn ambient_sample(event_id: &str, probability: f64) -> bool {
+    let hash = event_id.bytes().fold(0xcbf29ce484222325_u64, |hash, byte| {
+        (hash ^ u64::from(byte)).wrapping_mul(0x100000001b3)
+    });
+    let sample = (hash >> 11) as f64 / (1_u64 << 53) as f64;
+    sample < probability
+}
+
+/// 拒绝启动、加入之前或断线补来的旧消息，也不执行未来时间的事件。
+pub(super) fn is_new(timestamp_ms: i64, started_at_ms: i64, joined_ms: i64, now_ms: i64) -> bool {
+    timestamp_ms > started_at_ms
+        && timestamp_ms > joined_ms
+        && (0..=MAX_EVENT_AGE_MS).contains(&now_ms.saturating_sub(timestamp_ms))
+}
+
+/// 付费网关各类拒绝仅反馈可操作原因，不把上游错误正文或凭据发回房间。
+pub(super) fn gateway_notice(status: Option<u16>) -> &'static str {
+    match status {
+        Some(403) => "本房间尚未启用该付费角色，或使用授权已撤销。",
+        Some(402) => "本房间的角色额度或余额不足。",
+        Some(429) => "模型服务调用太频繁，请稍后再试。",
+        _ => "角色暂时无法回复。",
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn paid_gateway_status_has_small_user_notice_and_no_body() {
+        assert_eq!(
+            gateway_notice(Some(403)),
+            "本房间尚未启用该付费角色，或使用授权已撤销。"
+        );
+        assert_eq!(gateway_notice(Some(402)), "本房间的角色额度或余额不足。");
+        assert_eq!(
+            gateway_notice(Some(429)),
+            "模型服务调用太频繁，请稍后再试。"
+        );
+        assert_eq!(gateway_notice(Some(401)), gateway_notice(Some(503)));
+        assert_eq!(gateway_notice(None), "角色暂时无法回复。");
+    }
+
+    #[test]
+    fn rate_is_per_room_and_busy_does_not_queue_or_charge() {
+        use Trigger::Mention;
+        let mut state = Admission::default();
+        let a = "!a:example.com";
+        let b = "!b:example.com";
+        let now = 1_000_000;
+        assert_eq!(
+            state.decide(a, "$a1", now, now, true, Mention),
+            Decision::Model
+        );
+        assert_eq!(
+            state.decide(a, "$a2", now, now + 1, true, Mention),
+            Decision::RoomLimited
+        );
+        assert_eq!(
+            state.decide(b, "$b1", now, now + 1, false, Mention),
+            Decision::Busy
+        );
+        assert_eq!(
+            state.decide(b, "$b1", now, now + 2, true, Mention),
+            Decision::Ignore
+        );
+        assert_eq!(
+            state.decide(b, "$b2", now, now + 2, true, Mention),
+            Decision::Model
+        );
+        assert_eq!(
+            state.decide(a, "$a1", now, now + 10_000, true, Mention),
+            Decision::Ignore
+        );
+        assert_eq!(
+            state.decide(a, "$a3", now, now + 10_000, true, Mention),
+            Decision::Model
+        );
+    }
+
+    #[test]
+    fn ambient_waits_a_minute_per_room_without_changing_mention_limit() {
+        use Trigger::{Ambient, Mention};
+        let mut state = Admission::default();
+        let now = 1_000_000;
+        assert_eq!(
+            state.decide("a", "$a1", now, now, true, Ambient),
+            Decision::Model
+        );
+        assert_eq!(
+            state.decide("b", "$b1", now, now + 1, true, Ambient),
+            Decision::Model
+        );
+        assert_eq!(
+            state.decide("a", "$a2", now, now + 10_000, true, Ambient),
+            Decision::Ignore
+        );
+        assert_eq!(
+            state.decide("a", "$a3", now, now + 10_000, true, Mention),
+            Decision::Model
+        );
+        assert_eq!(
+            state.decide("a", "$a3", now, now + 60_000, true, Ambient),
+            Decision::Ignore
+        );
+        assert_eq!(
+            state.decide("a", "$a4", now, now + 60_000, true, Ambient),
+            Decision::Model
+        );
+    }
+
+    #[test]
+    fn only_local_main_senders_and_no_legacy_mentions() {
+        assert!(local_main_sender("pl_53", true));
+        for id in ["bot_flux-the-cat", "bot_other", "legacy", "pl_", "pl_other"] {
+            assert!(!local_main_sender(id, true));
+        }
+        assert!(!local_main_sender("pl_53", false));
+        assert!(ambient_has_legacy_mention("hi @friend", None));
+        assert!(ambient_has_legacy_mention(
+            "hi",
+            Some("<a href='matrix:u/person:domain'>hi</a>")
+        ));
+        assert!(!ambient_has_legacy_mention("hello", Some("<em>hello</em>")));
+    }
+
+    #[test]
+    fn card_probability_is_deterministic_and_preserves_endpoints() {
+        let first = ambient_sample("$matrix_event", 0.5);
+        assert_eq!(first, ambient_sample("$matrix_event", 0.5));
+        assert!(!ambient_sample("$matrix_event", 0.0));
+        assert!(ambient_sample("$matrix_event", 1.0));
+    }
+
+    #[test]
+    fn only_events_after_start_and_join_in_live_window() {
+        let now = 1_000_000;
+        assert!(!is_new(now - 5, now - 5, now - 20, now));
+        assert!(!is_new(now - 5, now - 20, now - 5, now));
+        assert!(!is_new(now - MAX_EVENT_AGE_MS - 1, 0, 0, now));
+        assert!(!is_new(now + 1, 0, 0, now));
+        assert!(is_new(now - 1, now - 10, now - 5, now));
+        assert!(is_new(now - MAX_EVENT_AGE_MS, 0, 0, now));
+    }
+}
diff --git a/src/bot/tavern_room.rs b/src/bot/tavern_room.rs
new file mode 100644
index 0000000000000000000000000000000000000000..26df44841f19e3a3440181b1e1e4441ded5dfa64
--- /dev/null
+++ b/src/bot/tavern_room.rs
@@ -0,0 +1,129 @@
+use mxlink::matrix_sdk::{
+    Room, RoomState,
+    deserialized_responses::SyncOrStrippedState,
+    ruma::{
+        EventEncryptionAlgorithm, OwnedEventId, UserId,
+        events::{
+            SyncStateEvent,
+            room::{
+                encryption::RoomEncryptionEventContent,
+                join_rules::{JoinRule, RoomJoinRulesEventContent},
+                member::{MembershipState, RoomMemberEventContent},
+            },
+        },
+    },
+};
+
+/// 房间能加入和提供回复的条件一致：普通邀请制，并且使用现有 Matrix 端到端加密。
+fn is_private_encrypted(
+    rule: &RoomJoinRulesEventContent,
+    algorithm: Option<&EventEncryptionAlgorithm>,
+) -> bool {
+    matches!(&rule.join_rule, JoinRule::Invite)
+        && matches!(algorithm, Some(EventEncryptionAlgorithm::MegolmV1AesSha2))
+}
+
+/// 只读原生邀请快照。不完整或未知的快照不试加入。
+pub(super) async fn eligible_invitation(room: &Room) -> anyhow::Result<bool> {
+    if room.state() != RoomState::Invited {
+        return Ok(false);
+    }
+    let Some(rule) = room
+        .get_state_event_static::<RoomJoinRulesEventContent>()
+        .await?
+    else {
+        return Ok(false);
+    };
+    let Some(crypto) = room
+        .get_state_event_static::<RoomEncryptionEventContent>()
+        .await?
+    else {
+        return Ok(false);
+    };
+    let (SyncOrStrippedState::Stripped(rule), SyncOrStrippedState::Stripped(crypto)) =
+        (rule.deserialize()?, crypto.deserialize()?)
+    else {
+        return Ok(false);
+    };
+    Ok(is_private_encrypted(
+        &rule.content,
+        crypto.content.algorithm.as_ref(),
+    ))
+}
+
+/// 只读已同步的正式房间和 Bot 现有成员状态；没有资格或未加入时不交给模型。
+/// 返回成员状态时间，用来排除加入前已存在的消息，不回读聊天事件。
+pub(super) async fn joined_after(
+    room: &Room,
+    bot_mxid: &UserId,
+) -> anyhow::Result<Option<(i64, OwnedEventId)>> {
+    if room.state() != RoomState::Joined || !room.is_synced() {
+        return Ok(None);
+    }
+    let Some(rule) = room
+        .get_state_event_static::<RoomJoinRulesEventContent>()
+        .await?
+    else {
+        return Ok(None);
+    };
+    let Some(crypto) = room
+        .get_state_event_static::<RoomEncryptionEventContent>()
+        .await?
+    else {
+        return Ok(None);
+    };
+    let (
+        SyncOrStrippedState::Sync(SyncStateEvent::Original(rule)),
+        SyncOrStrippedState::Sync(SyncStateEvent::Original(crypto)),
+    ) = (rule.deserialize()?, crypto.deserialize()?)
+    else {
+        return Ok(None);
+    };
+    if !is_private_encrypted(&rule.content, Some(&crypto.content.algorithm)) {
+        return Ok(None);
+    }
+    let Some(member) = room
+        .get_state_event_static_for_key::<RoomMemberEventContent, _>(bot_mxid)
+        .await?
+    else {
+        return Ok(None);
+    };
+    Ok(match member.deserialize()? {
+        SyncOrStrippedState::Sync(SyncStateEvent::Original(event))
+            if event.content.membership == MembershipState::Join =>
+        {
+            let timestamp: u64 = event.origin_server_ts.0.into();
+            i64::try_from(timestamp).ok().map(|ms| (ms, event.event_id))
+        }
+        _ => None,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_invite_only_with_megolm_qualifies() {
+        let megolm = RoomEncryptionEventContent::with_recommended_defaults();
+        let encrypted = |rule| {
+            is_private_encrypted(
+                &RoomJoinRulesEventContent::new(rule),
+                Some(&megolm.algorithm),
+            )
+        };
+        assert!(encrypted(JoinRule::Invite));
+        assert!(!encrypted(JoinRule::Public));
+        assert!(!encrypted(JoinRule::Knock));
+        assert!(!is_private_encrypted(
+            &RoomJoinRulesEventContent::new(JoinRule::Invite),
+            None
+        ));
+        let other_crypto =
+            RoomEncryptionEventContent::new(EventEncryptionAlgorithm::OlmV1Curve25519AesSha2);
+        assert!(!is_private_encrypted(
+            &RoomJoinRulesEventContent::new(JoinRule::Invite),
+            Some(&other_crypto.algorithm)
+        ));
+    }
+}
