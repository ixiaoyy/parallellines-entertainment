+#[cfg(test)]
+mod tavern_gateway_tests {
+    use super::*;
+
+    fn paid_event() -> crate::agent::provider::openai_compat::TavernFluxContext {
+        use mxlink::matrix_sdk::ruma::{OwnedEventId, OwnedRoomId};
+        crate::agent::provider::openai_compat::TavernFluxContext {
+            room_id: OwnedRoomId::try_from("!tavern:example.org").unwrap(),
+            event_id: OwnedEventId::try_from("$test_event").unwrap(),
+        }
+    }
+
+    #[test]
+    fn paid_request_uses_only_service_bearer_and_actual_event_headers() {
+        let paid = Controller::new(Config {
+            base_url: crate::agent::provider::openai_compat::TAVERN_FLUX_BASE_URL.to_owned(),
+            api_key: Some("synthetic-service-token".to_owned()),
+            ..Config::default()
+        })
+        .unwrap();
+        assert!(paid.chat_request(None).is_err());
+        let request = paid
+            .chat_request(Some(paid_event()))
+            .unwrap()
+            .build()
+            .unwrap();
+        assert_eq!(request.method(), reqwest::Method::POST);
+        assert_eq!(
+            request.url().as_str(),
+            "https://api.pingxingxian.space/tavern-flux/v1/chat/completions"
+        );
+        assert_eq!(
+            request.headers()["Authorization"],
+            "Bearer synthetic-service-token"
+        );
+        assert_eq!(request.headers()["X-Tavern-Room-Id"], "!tavern:example.org");
+        assert_eq!(request.headers()["X-Tavern-Event-Id"], "$test_event");
+        assert_eq!(request.headers().len(), 3);
+
+        let ordinary = Controller::new(Config {
+            base_url: "https://example.org/v1".to_owned(),
+            ..Config::default()
+        })
+        .unwrap();
+        assert!(ordinary.chat_request(Some(paid_event())).is_err());
+        let request = ordinary.chat_request(None).unwrap().build().unwrap();
+        assert_eq!(
+            request.url().as_str(),
+            "https://example.org/v1/chat/completions"
+        );
+        assert!(!request.headers().contains_key("X-Tavern-Room-Id"));
+        assert!(!request.headers().contains_key("X-Tavern-Event-Id"));
+    }
+}
